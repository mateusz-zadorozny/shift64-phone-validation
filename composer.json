{
    "name": "shift64/shift64-phone-validation",
    "description": "WordPress plugin for phone number validation using libphonenumber",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "giggsey/libphonenumber-for-php-lite": "^9.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "^11.2",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-cli/i18n-command": "^2",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Shift64\\SmartPhoneValidation\\": "src/"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "makepot": "wp i18n make-pot . languages/shift64-phone-validation.pot --slug=shift64-phone-validation",
        "makepo": "wp i18n update-po languages/shift64-phone-validation.pot languages/",
        "makemo": "wp i18n make-mo languages/"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    }
}
