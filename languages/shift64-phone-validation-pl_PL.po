#. Plugin Name of the plugin
#: shift64-phone-validation.php:3
msgid "SHIFT64 Phone Validation for WooCommerce"
msgstr "SHIFT64 Walidacja Telefonu dla WooCommerce"

#. Plugin URI of the plugin
#: shift64-phone-validation.php:4
msgid "https://github.com/mateusz-zadorozny/shift64-phone-validation"
msgstr "https://github.com/mateusz-zadorozny/shift64-phone-validation"

#. Description of the plugin
#: shift64-phone-validation.php:5
msgid "Validates and formats WooCommerce checkout phone numbers with Google's libphonenumber library."
msgstr "Waliduje i formatuje numery telefonów podawane podczas składania zamówienia w WooCommerce, korzystając z biblioteki libphonenumber od Google."

#. Author of the plugin
#: shift64-phone-validation.php:6
msgid "Mateusz Zadorożny (SHIFT64)"
msgstr "Mateusz Zadorożny (SHIFT64)"

#. Author URI of the plugin
#: shift64-phone-validation.php:7
msgid "https://shift64.com"
msgstr "https://shift64.com"

#: shift64-phone-validation.php:72
msgid "SHIFT64 Phone Validation for WooCommerce cannot run because its bundled vendor folder is missing. Reinstall the plugin from WordPress.org or from the release ZIP on GitHub."
msgstr "Wtyczka SHIFT64 Walidacja Telefonu dla WooCommerce nie może działać, ponieważ brakuje dołączonego do niej katalogu vendor. Zainstaluj wtyczkę ponownie z WordPress.org lub z pliku ZIP wydania na GitHubie."

#. translators: 1: minimum WordPress version, e.g. 7.1, 2: WordPress version this site runs
#: src/Admin/DependencyChecker.php:78
#, php-format
msgid "SHIFT64 Phone Validation for WooCommerce requires WordPress %1$s or later, and this site runs WordPress %2$s. Until WordPress is updated, phone numbers are not checked at checkout."
msgstr "Wtyczka SHIFT64 Walidacja Telefonu dla WooCommerce wymaga WordPressa w wersji %1$s lub nowszej, a ta witryna działa na WordPressie %2$s. Dopóki WordPress nie zostanie zaktualizowany, numery telefonów nie są sprawdzane przy składaniu zamówień."

#: src/Admin/DependencyChecker.php:122
msgid "SHIFT64 Phone Validation for WooCommerce requires WooCommerce to be installed and activated."
msgstr "Wtyczka SHIFT64 Walidacja Telefonu dla WooCommerce wymaga zainstalowania i aktywacji WooCommerce."

#: src/Admin/Settings.php:54
msgid "Phone Validation"
msgstr "Walidacja Telefonu"

#: src/Admin/Settings.php:84
msgid "Phone Validation Settings"
msgstr "Ustawienia Walidacji Telefonu"

#: src/Admin/Settings.php:86
msgid "Configure phone number validation and formatting behavior."
msgstr "Skonfiguruj zachowanie walidacji i formatowania numerów telefonów."

#: src/Admin/Settings.php:90
msgid "Enable Validation"
msgstr "Włącz Walidację"

#: src/Admin/Settings.php:91
msgid "Enable phone number validation globally"
msgstr "Włącz walidację numerów telefonów globalnie"

#: src/Admin/Settings.php:95
msgid "When enabled, phone numbers will be validated during checkout."
msgstr "Po włączeniu numery telefonów będą walidowane podczas składania zamówienia."

#: src/Admin/Settings.php:98
msgid "Default Country"
msgstr "Domyślny Kraj"

#: src/Admin/Settings.php:99
msgid "Used for numbers entered without \"+\" only when the address has no country. Otherwise the number is read in the country of the billing / shipping address."
msgstr "Używany dla numerów wpisanych bez „+” tylko wtedy, gdy adres nie ma kraju. W pozostałych przypadkach numer jest odczytywany w kraju z adresu rozliczeniowego / wysyłki."

#: src/Admin/Settings.php:108
msgid "Validation Mode"
msgstr "Tryb Walidacji"

#: src/Admin/Settings.php:109
msgid "Choose how phone numbers should be validated."
msgstr "Wybierz sposób walidacji numerów telefonów."

#: src/Admin/Settings.php:115
msgid "Default country + international"
msgstr "Domyślny kraj + międzynarodowe"

#: src/Admin/Settings.php:116
msgid "International only"
msgstr "Tylko międzynarodowe"

#: src/Admin/Settings.php:121
msgid "Output Format"
msgstr "Format Wyjściowy"

#: src/Admin/Settings.php:122
msgid "Select the format for storing phone numbers."
msgstr "Wybierz format zapisu numerów telefonów."

#: src/Admin/Settings.php:128
msgid "E.164 (e.g., +48123456789)"
msgstr "E.164 (np. +48123456789)"

#: src/Admin/Settings.php:129
msgid "International (e.g., +48 123 456 789)"
msgstr "Międzynarodowy (np. +48 123 456 789)"

#: src/Admin/Settings.php:130
msgid "National (e.g., 123 456 789)"
msgstr "Krajowy (np. 123 456 789)"

#: src/Admin/Settings.php:135
msgid "Enable Formatting on Save"
msgstr "Włącz Formatowanie przy Zapisie"

#: src/Admin/Settings.php:136
msgid "Automatically format phone numbers when saving"
msgstr "Automatycznie formatuj numery telefonów podczas zapisywania"

#: src/Admin/Settings.php:140
msgid "When enabled, phone numbers will be reformatted to the selected output format before saving."
msgstr "Po włączeniu numery telefonów będą przeformatowane do wybranego formatu przed zapisaniem."

